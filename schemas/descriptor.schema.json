{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-sdk/descriptor/0.1",
  "title": "audio-sdk provider descriptor 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buffering_delay_samples", "callback_safe", "configuration_schema_digest",
    "contract_version", "edge_exclusions", "execution_modes",
    "implementation_id", "implementation_version", "max_drain_calls",
    "native_hop_samples", "platform", "provider_id", "required_assets",
    "schema_id", "source_digest", "source_revision", "supported_formats",
    "upstream"
  ],
  "properties": {
    "schema_id": {"const": "audio-sdk/descriptor/0.1"},
    "contract_version": {"const": "0.1"},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "implementation_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "implementation_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_revision": {"type": ["string", "null"]},
    "source_digest": {"$ref": "#/$defs/digest"},
    "configuration_schema_digest": {"$ref": "#/$defs/digest"},
    "supported_formats": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["channels", "frame_samples", "sample_format", "sample_rate_hz"],
        "properties": {
          "sample_format": {"const": "f32"},
          "sample_rate_hz": {"const": 16000},
          "channels": {"const": 1},
          "frame_samples": {"const": 160}
        }
      }
    },
    "native_hop_samples": {"type": "integer", "minimum": 1, "maximum": 16000},
    "buffering_delay_samples": {"type": "integer", "minimum": 0, "maximum": 16000},
    "edge_exclusions": {
      "type": "object", "additionalProperties": false,
      "required": ["start_samples", "end_samples"],
      "properties": {
        "start_samples": {"type": "integer", "minimum": 0, "maximum": 16000},
        "end_samples": {"type": "integer", "minimum": 0, "maximum": 16000}
      }
    },
    "max_drain_calls": {"type": "integer", "minimum": 1, "maximum": 1024},
    "callback_safe": {"type": "boolean"},
    "execution_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3]}
    },
    "required_assets": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["byte_count", "id", "sha256", "storage"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"},
          "sha256": {"$ref": "#/$defs/digest"},
          "byte_count": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "storage": {"const": "external"}
        }
      }
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["license", "name", "notice_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "notice_path": {"type": "string", "minLength": 1}
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["architectures", "cpu_requirements"],
      "properties": {
        "architectures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cpu_requirements": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
