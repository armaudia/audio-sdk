{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-sdk/provider-intake/0.1",
  "title": "audio-sdk provider intake record",
  "description": "Review artifact for admitting a provider, model, tool or adapter. It does not by itself establish release qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "provider_id",
    "implementation_id",
    "implementation_version",
    "contract_version",
    "source_revision",
    "source_digest",
    "source_manifest_ref",
    "descriptor_ref",
    "descriptor_digest",
    "distribution",
    "packages_assets",
    "assets",
    "rights",
    "runtime",
    "evaluation",
    "customer_scope",
    "playback_scope",
    "review",
    "reopen_condition"
  ],
  "properties": {
    "schema_id": { "const": "audio-sdk/provider-intake/0.1" },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "implementation_id": { "type": "string", "pattern": "\\S", "maxLength": 96 },
    "implementation_version": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 64
    },
    "contract_version": { "const": "0.1" },
    "source_revision": {
      "anyOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }]
    },
    "source_digest": { "$ref": "#/$defs/digest" },
    "source_manifest_ref": { "$ref": "#/$defs/fileRef" },
    "descriptor_ref": { "$ref": "#/$defs/fileRef" },
    "descriptor_digest": { "$ref": "#/$defs/digest" },
    "distribution": {
      "enum": ["source-linked", "binary", "service"]
    },
    "packages_assets": { "type": "boolean" },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/asset" }
    },
    "rights": { "$ref": "#/$defs/rights" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "optional_dependency", "platforms"],
      "properties": {
        "kind": { "enum": ["none", "cpu", "gpu", "npu", "service"] },
        "optional_dependency": { "type": "string", "pattern": "\\S", "maxLength": 128 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S", "maxLength": 64 }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "scope", "evidence_ref", "paired_quality", "runtime_claim"],
      "properties": {
        "task": { "type": "string", "pattern": "\\S", "maxLength": 128 },
        "scope": { "type": "string", "pattern": "\\S", "maxLength": 512 },
        "evidence_ref": { "$ref": "#/$defs/fileRef" },
        "paired_quality": { "enum": ["supported", "not-supported", "unknown"] },
        "runtime_claim": { "enum": ["supported", "not-supported", "unknown"] }
      }
    },
    "customer_scope": { "enum": ["allowed", "denied", "unknown"] },
    "playback_scope": { "enum": ["allowed", "denied", "unknown"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "review_date", "decision"],
      "properties": {
        "reviewer": { "type": ["string", "null"], "pattern": "\\S", "maxLength": 128 },
        "review_date": { "type": ["string", "null"], "format": "date" },
        "decision": { "enum": ["approved", "rejected", "pending"] }
      },
      "if": { "properties": { "decision": { "const": "pending" } } },
      "then": { "properties": { "reviewer": { "type": "null" }, "review_date": { "type": "null" } } },
      "else": { "properties": { "reviewer": { "type": "string" }, "review_date": { "type": "string" } } }
    },
    "reopen_condition": { "type": "string", "pattern": "\\S", "maxLength": 512 }
  },
  "$defs": {
    "fileRef": {
      "description": "Path relative to the evidence root, resolving to a file within that root.",
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "revision": {
      "type": "string",
      "pattern": "^(?!0+$)(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["allowed", "denied", "unknown"] },
        "evidence_ref": { "$ref": "#/$defs/fileRef" },
        "reviewer": { "type": "string", "pattern": "\\S", "maxLength": 128 },
        "review_date": { "type": "string", "format": "date" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "allowed" } },
            "required": ["decision"]
          },
          "then": {
            "required": ["evidence_ref", "reviewer", "review_date"]
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition", "evaluation", "redistribution", "public_playback"],
      "properties": {
        "acquisition": { "$ref": "#/$defs/decision" },
        "evaluation": { "$ref": "#/$defs/decision" },
        "redistribution": { "$ref": "#/$defs/decision" },
        "public_playback": { "$ref": "#/$defs/decision" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "byte_count", "class", "rights", "checkpoint"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "class": { "enum": ["public", "restricted", "closed"] },
        "rights": { "$ref": "#/$defs/rights" },
        "checkpoint": {
          "description": "Null for non-model inputs; required provenance object for a checkpoint.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["upstream_revision", "tensor_config_ref", "precision", "inventory_ref"],
          "properties": {
            "upstream_revision": { "$ref": "#/$defs/revision" },
            "tensor_config_ref": { "$ref": "#/$defs/fileRef" },
            "precision": { "type": "string", "pattern": "\\S", "maxLength": 64 },
            "inventory_ref": { "$ref": "#/$defs/fileRef" }
          }
        }
      }
    }
  }
}
