{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-sdk/effective-config/0.1",
  "title": "audio-sdk effective configuration 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adaptation", "application_contract", "batching", "clipping_policy",
    "descriptor_digest", "engine", "execution_mode", "float_to_int_policy",
    "input", "input_queue_capacity", "output_queue_capacity", "precision",
    "processors", "provider_contract", "resampling", "schema_id", "worker_count"
  ],
  "properties": {
    "schema_id": {"const": "audio-sdk/effective-config/0.1"},
    "application_contract": {"const": "audio-sdk/application/0.1"},
    "provider_contract": {"const": "0.1"},
    "descriptor_digest": {"$ref": "#/$defs/digest"},
    "engine": {"const": "reference.sequential.v0"},
    "execution_mode": {"type": "integer", "enum": [2, 3]},
    "worker_count": {"type": "integer", "enum": [0, 1]},
    "input_queue_capacity": {"type": "integer", "enum": [0, 3]},
    "output_queue_capacity": {"type": "integer", "enum": [0, 3]},
    "precision": {"const": "f32"},
    "adaptation": {"const": "off"},
    "resampling": {"const": "none"},
    "batching": {"const": false},
    "clipping_policy": {"type": "string"},
    "float_to_int_policy": {"type": "string"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["channels", "frame_samples", "sample_format", "sample_rate_hz"],
      "properties": {
        "sample_format": {"const": "f32"},
        "sample_rate_hz": {"const": 16000},
        "channels": {"const": 1},
        "frame_samples": {"const": 160}
      }
    },
    "processors": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["asset_hashes", "id", "settings"],
        "properties": {
          "id": {"type": "string"},
          "asset_hashes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/digest"}},
          "settings": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
