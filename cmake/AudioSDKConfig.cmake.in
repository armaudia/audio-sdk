@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(AudioSDKAPI 0.1 CONFIG
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../AudioSDKAPI" NO_DEFAULT_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/AudioSDKTargets.cmake")

if(NOT TARGET AudioSDK::core)
    add_library(AudioSDK::core ALIAS AudioSDK::audio_sdk)
endif()
check_required_components(AudioSDK)
