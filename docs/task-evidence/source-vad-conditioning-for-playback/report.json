D weights, runtime lock, typed annotation schema, cohort manifest, matched reference output and source each lack byte count, SHA-256, licence and consent review.","id":"B-02","reopen":"Caller supplies all six external assets by id, byte count and SHA-256 with reviewed licence/consent sidecars and verified bytes; no embedded asset or SDK file access is accepted."},{"blocker":"No matched Rate-profile evidence exists. The pinned pre-screen used three clips and a batch gate, with no listener result, no block-streaming gate, no pitch/transient score and no measured unknown-span or speech-preservation result.","id":"B-03","reopen":"Run a rights-cleared matched cohort at installed 16 kHz mono float32/160-sample geometry and report exact source intervals, duration, pitch, transients, buffering, speech preservation and typed unknown-span outcomes separately."},{"blocker":"No opt-in adapter intake or release decision exists, and the pinned note requires counsel review of the real-time playback policy before a shipping path is considered.","id":"B-04","reopen":"Obtain credential review, counsel posture and an application-local opt-in decision with no default, public registry or ABI change; keep public admission a separate later gate."}],"format":{"channels":1,"frame_samples":160,"sample_format":"float32","sample_rate_hz":16000},"gates":[{"id":"RG-01","missing":"exact source revision and build lock","name":"exact_runnable_source","qualifies":false,"status":"blocked"},{"id":"RG-02","missing":"six caller assets with SHA-256, byte count and licence review","name":"exact_assets_and_rights","qualifies":false,"status":"blocked"},{"id":"RG-03","missing":"opt-in intake without ABI, registry or default change","name":"installed_v0_boundary","qualifies":false,"status":"blocked"},{"id":"RG-04","missing":"validated annotation schema on matched input","name":"typed_content_annotations","qualifies":false,"status":"blocked"},{"id":"RG-05","missing":"measured classifier unknown/deletion behavior","name":"unknown_span_behavior","qualifies":false,"status":"blocked"},{"id":"RG-06","missing":"duration, pitch, transient, buffering and preservation evidence","name":"rate_profile_evidence","qualifies":false,"status":"blocked"},{"id":"RG-07","missing":"target-device pacing, crossfade and listening result","name":"playback_pacing_and_listening","qualifies":false,"status":"blocked"},{"id":"RG-08","missing":"rights, counsel and opt-in release decision","name":"public_admission_review","qualifies":false,"status":"blocked"}],"identity_control":{"alternating_integer_sequence_byte_identical":true,"label":"integer identity, not VAD-conditioned output","output_end":16000,"output_sha256":"3a7e3397ac1be3e80f6f670e667f40735f68304db0475cae9535ba37cf0ad33f","pattern_sha256":"3a7e3397ac1be3e80f6f670e667f40735f68304db0475cae9535ba37cf0ad33f","qualifies":false,"source_end":16000},"missing_evidence":["exact runnable source revision, archive hash and build lock","six exact external assets with byte counts, SHA-256 and rights sidecars","validated typed-annotation schema on matched input","measured unknown-span, deletion and crossfade behavior","Rate-profile duration, pitch, transient, buffering and preservation results","target pacing, listening and opt-in credential/counsel review"],"negative_claims":["No VAD model, ASR gate, syllable estimator or time-stretcher is loaded or executed.","No exact caller source, weights, runtime lock, typed annotation schema or rights-cleared cohort is present.","No real audio is read, written, rendered, played or listened to.","No device timing, callback deadline, pacing or buffer occupancy result is measured.","No source-reported VAD score, pre-screen RTF, WER proxy or IoU is reproduced or promoted.","No silence decision is represented as deletion; unknown spans are retained and explicitly typed.","No provider, descriptor, registry entry, default, ABI, shared-build or CI file is changed.","No benchmark, release, public admission or qualification result is claimed."],"no_missing_result_qualifies_candidate":true,"profile":"Rate","qualification_status":"not_qualified","rate_profile":{"item_count":9,"items":[{"id":"source_output_mapping","qualifies":false,"requirement":"Exact half-open sample intervals","status":"blocked","synthetic_control":"four contiguous typed segments, integer output boundaries"},{"id":"duration","qualifies":false,"requirement":"Source/output duration and rate closure","status":"blocked","synthetic_control":"16000 source samples -> 16000 output samples"},{"id":"pitch","qualifies":false,"requirement":"Pitch audibility","status":"blocked","synthetic_control":"not_measured_no_rendered_audio"},{"id":"transient_audibility","qualifies":false,"requirement":"Transient audibility","status":"blocked","synthetic_control":"not_measured_no_rendered_audio"},{"id":"playback_buffering","qualifies":false,"requirement":"Buffering, fill/flush and gap behavior","status":"blocked","synthetic_control":"no device FIFO; no timing claim"},{"id":"rate_cases","qualifies":false,"requirement":"1x, rate changes, unfamiliar speech, music, silence, rebuffer, drift, final partial","status":"blocked","synthetic_control":"synthetic classes only at 1, 4/5 and 4/3; no unfamiliar speech or music"},{"id":"pause_timestamps","qualifies":false,"requirement":"Pause/filler decisions tied to source timestamps","status":"blocked","synthetic_control":"typed intervals in 160-sample source coordinates"},{"id":"speech_preservation","qualifies":false,"requirement":"Measured speech preservation","status":"blocked","synthetic_control":"not_measured_without_clean references or listening"},{"id":"unknown_span","qualifies":false,"requirement":"Measured unknown-span behavior","status":"blocked","synthetic_control":"synthetic retention control; no classifier measurement"}],"profile_source":"audio-benchmark-platform/plan/swarm/VERIFICATION.md:21","qualifies":false},"reopening_conditions":["Supply a 40-hex source revision, SHA-256 of the exact source archive, build lock and caller attestation through the manifest; verify hashes without downloading or executing source here.","Caller supplies all six external assets by id, byte count and SHA-256 with reviewed licence/consent sidecars and verified bytes; no embedded asset or SDK file access is accepted.","Run a rights-cleared matched cohort at installed 16 kHz mono float32/160-sample geometry and report exact source intervals, duration, pitch, transients, buffering, speech preservation and typed unknown-span outcomes separately.","Obtain credential review, counsel posture and an application-local opt-in decision with no default, public registry or ABI change; keep public admission a separate later gate."],"repeatability":{"canonical":"sorted keys, compact separators, allow_nan=False, one trailing LF","comparison":"exact SHA-256 over bytes; no tolerance","fresh_builds":3},"repository":"audio-sdk","schema_id":"audio-sdk/task-evidence-report/0.1","scope":{"benchmark":false,"caller_assets_present":false,"device_timing":false,"listening":false,"model_download":false,"provider_default_or_abi_change":false,"real_audio":false,"release_claim":false,"synthetic_only":true,"task_local_only":true},"source_lines":{"entries":[{"id":"content-gate-classes","line":616,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"**Content gate.** Classify 20\u201350 ms frames, then aggregate into segments of at least 200\u2013300 ms:"},{"id":"vad-silence-action","line":620,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"| Silence / pause | VAD (Silero is already vendored) | Compress hard, or cut with a 5\u201310 ms crossfade |"},{"id":"lookahead-unavoidable","line":649,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"**Lookahead is unavoidable.** You cannot slow the start of an utterance after you have already played it. The output must be delayed by the classifier's lookahead `L` (roughly 200\u2013500 ms for streaming ASR partials; 0.5\u20131 s for reliable word timestamps). That `L` is added latency even at 1.0\u00d7 and must be reported separately from the stretcher's algorithmic delay. Without lookahead, the first 200\u2013500 ms of a fast utterance plays at 1.0\u00d7."},{"id":"s1-no-semantics","line":664,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"1. **S1 \u2014 no semantics:** VAD + syllable rate + silence compression. This already delivers most of the benefit and needs no ASR."},{"id":"gate-partly-done","line":1015,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"2. **P1 (partly done):** the content gate exists as a Vosk batch call in the harness (IoU 0.94\u20130.95 against construction-time labels on TTS). It has **not** been measured as a block-streaming gate, and its word timestamps are uncalibrated. The planned sherpa-onnx streaming gate remains P1."},{"id":"pre-screen-limited","line":1028,"path":"cpp-library/pipeline-validation/playback-speed-candidates.md","sha256":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","text":"The pre-screen does **not** establish a WER difference between D1 and D2, and no listener has scored the output. Carry **D2 + Sonic** as the cost baseline and **D2 + Bungee** as the quality reference into the next gate. Do not choose the gate or the planner on three clips."},{"id":"vad-candidate-comparison","line":10,"path":"REALTIME_COMPONENT_CANDIDATES.md","sha256":"294ee2fbf04ff00e438cded6365312f575be0f0162854fdf46972f670c688f5d","text":"| Silero VAD 6.2.3 | Stateful speech detection | 68.35 \u00b5s per 20 ms frame; held-out AMI FN 19.43%, FP 8.20%. Stateful C++ path exists. |"},{"id":"typed-annotation-plan-note","line":8231,"path":"audio-benchmark-platform/plan/INVENTORY.json","sha256":"46d09945deb235cdd948eb48f827aa15fc24ddc8c902668810f7718fc00f889c","text":"\"plan_note\": \"Use typed content annotations and measured unknown-span behavior, without turning every silence decision into deletion.\","},{"id":"rate-profile","line":21,"path":"audio-benchmark-platform/plan/swarm/VERIFICATION.md","sha256":"3f2631333e4436a6441236a2b21f4d5b45fb3bb3619f600767e22eb957f77910","text":"| Rate | Measure source/output mapping, duration, pitch, transient audibility and playback buffering. Include 1\u00d7, rate changes, unfamiliar speech, music, silence, rebuffer, drift and the final partial window. Keep pause or filler decisions tied to source timestamps and measure speech preservation. |"}],"line_count":9},"source_pins":{"REALTIME_COMPONENT_CANDIDATES.md":"294ee2fbf04ff00e438cded6365312f575be0f0162854fdf46972f670c688f5d","adapters/silero-vad/adapter.json":"45222fd98fe1bd76550d0529cdaa442783807a727880b168d7879eca4f54a60a","audio-benchmark-platform/audio-sdk/CONTRACTS.md":"f6fdd18f9d5361ab9592015dce1db9733e18674b15bf0c3f657add1416653c69","audio-benchmark-platform/plan/INVENTORY.json":"46d09945deb235cdd948eb48f827aa15fc24ddc8c902668810f7718fc00f889c","audio-benchmark-platform/plan/audio-sdk/README.md":"f72d6b50a61e7ff469cda0480e8f5ffa93edbfe747a45624db5faad54847be06","audio-benchmark-platform/plan/swarm/VERIFICATION.md":"3f2631333e4436a6441236a2b21f4d5b45fb3bb3619f600767e22eb957f77910","cpp-library/pipeline-validation/playback-speed-candidates.md":"661a471ad50e3335b18fdb6d8664f6fda0534ad37196fb9e3f58ff61c58f34b3","cpp-library/pipeline-validation/playback-speed/README.md":"a7bde2c76ba2deaf0920b14d75b5d1bf72861ed3b1d6d735bfe0bbe83256635f","cpp-library/pipeline-validation/playback-speed/results/report.md":"9c9383297b1160dbe4f7261f789b493d70354b11930f4d8527b20b0ca8c8